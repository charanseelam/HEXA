body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #0f172a;
  color: white;
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(2, 6, 23, 0.95);
  padding: 16px 32px;
  color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid rgba(148, 163, 184, 0.16);
  backdrop-filter: blur(12px);
}

.logo-wrap {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
}

.logo-mark {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #00d2ff, #4ade80);
  color: #020617;
  font-weight: 800;
}

.logo {
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: #ffffff;
  margin: 0;
}

.logo-sub {
  font-size: 0.72rem;
  color: #94a3b8;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.nav-links {
  display: flex;
  align-items: center;
  list-style: none;
  gap: 28px;
  margin: 0;
  padding: 0;
}

.nav-links a,
.dropdown-title {
  color: #e2e8f0;
  text-decoration: none;
  font-size: 0.95rem;
  cursor: pointer;
  user-select: none;
  transition: color 0.2s ease;
}

.nav-links a:hover,
.dropdown:hover .dropdown-title {
  color: #38bdf8;
}

.dropdown {
  position: relative;
  padding: 8px 0;
  cursor: pointer;
}

.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 160px;
  background-color: #0b1322;
  border: 1px solid #1e293b;
  border-radius: 10px;
  padding: 8px 0;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  opacity: 0;
  visibility: hidden;
  transform: translateY(8px);
  transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  pointer-events: none;
}

.dropdown:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.dropdown-menu a {
  padding: 10px 16px;
  font-size: 0.9rem;
  color: #94a3b8;
  text-align: left;
  white-space: nowrap;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.dropdown-menu a:hover {
  background-color: #1e293b;
  color: #ffffff;
}

.actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.btn {
  background: linear-gradient(135deg, #00d2ff, #4ade80);
  color: #020617 !important;
  padding: 0.7rem 1rem;
  border-radius: 999px;
  font-weight: 700;
  text-decoration: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 8px 24px rgba(0, 210, 255, 0.2);
}

.btn:hover {
  transform: translateY(-1px);
}

.login {
  color: #e2e8f0;
  text-decoration: none;
  font-weight: 600;
  border: 1px solid rgba(0, 210, 255, 0.35);
  padding: 0.6rem 0.95rem;
  border-radius: 999px;
  background: rgba(255,255,255,0.03);
}

.hero {
  position: relative;
  min-height: 84vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #020617;
}

.bg-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.4) saturate(0.8);
}

.overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(2, 6, 23, 0.96) 0%, rgba(2, 6, 23, 0.7) 55%, rgba(2, 6, 23, 0.4) 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
  max-width: 760px;
  padding: 2rem;
}

.hero-badge {
  display: inline-block;
  padding: 0.45rem 0.75rem;
  border-radius: 999px;
  background: rgba(0, 210, 255, 0.12);
  border: 1px solid rgba(0, 210, 255, 0.24);
  color: #7dd3fc;
  font-size: 0.8rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}

.hero h1 {
  font-size: clamp(2.2rem, 4vw, 3.7rem);
  line-height: 1.05;
  margin: 0 0 1rem;
  color: #fff;
}

.hero h1 span {
  color: #00d2ff;
}

.hero p {
  font-size: 1.05rem;
  color: #cbd5e1;
  max-width: 620px;
  margin: 0 0 1.4rem;
}

.buttons {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1.4rem;
}

.open,
.hero .login {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.85rem 1.2rem;
  border-radius: 999px;
  font-weight: 700;
  text-decoration: none;
}

.open {
  background: linear-gradient(135deg, #00d2ff, #4ade80);
  color: #020617;
}

.hero .login {
  background: rgba(255,255,255,0.08);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.18);
}

.hero-stats {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.hero-stats div {
  padding: 0.8rem 1rem;
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.18);
  min-width: 130px;
}

.hero-stats strong {
  display: block;
  color: #fff;
  font-size: 1.05rem;
}

.hero-stats span {
  color: #94a3b8;
  font-size: 0.85rem;
}
